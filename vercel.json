{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "auth_1/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "auth_2/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "login/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "landing/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "forgot_password/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/health",
      "dest": "/health.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

